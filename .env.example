# Plantilla del .env — SOLO LAS CLAVES, sin valores.
#
# El .env real nunca va a git y vive únicamente en el servidor. Esta plantilla
# existe para que al mudar de VPS no haya que adivinar qué variables hacen
# falta: se copia, se completa y listo.
#
# POSTGRES_PASSWORD y SECRET_KEY tienen que ser propios de producción. Los
# valores por defecto que trae docker-compose.yml (vistiendome2024) son para
# desarrollo y no pueden salir de ahí.

# Database Configuration
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
DATABASE_URL=

# Security
SECRET_KEY=
ALGORITHM=
ACCESS_TOKEN_EXPIRE_MINUTES=

# Client Configuration
VITE_API_URL=
APP_ENV=
DEV_MODE=
